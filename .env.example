# Copy to .env and provide an OpenAI-compatible provider key.
HARNESS_LLM_BASE=https://api.deepseek.com
HARNESS_LLM_MODEL=deepseek-v4-flash
HARNESS_LLM_KEY=sk-xxxxxxxxxxxxxxxxxxx
HARNESS_LLM_TEMPERATURE=0.0
HARNESS_MAX_STEPS=20

# Context budget. Token budget uses a deterministic estimate unless a provider tokenizer is configured.
HARNESS_MAX_CONTEXT_CHARS=45000
HARNESS_CONTEXT_MIN_TAIL=4
HARNESS_MAX_CONTEXT_TOKENS=
# auto uses tiktoken when installed; char selects the explicit chars/4 fallback.
HARNESS_TOKENIZER=auto

# Provider timeout and bounded exponential retry.
HARNESS_LLM_TIMEOUT=120.0
HARNESS_LLM_RETRIES=2
HARNESS_LLM_BACKOFF=0.5
HARNESS_INPUT_COST_PER_MILLION=0
HARNESS_OUTPUT_COST_PER_MILLION=0

# Execution backend: auto uses Docker/Podman when available, local otherwise.
HARNESS_SANDBOX_BACKEND=auto
HARNESS_SANDBOX_IMAGE=python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285
HARNESS_SANDBOX_NETWORK=0
HARNESS_SANDBOX_WHITELIST=
HARNESS_SANDBOX_DENYLIST=
HARNESS_SANDBOX_DENY_PATTERNS=
HARNESS_SANDBOX_READONLY=0
HARNESS_SANDBOX_TIMEOUT=30.0
HARNESS_SANDBOX_MAX_OUTPUT_BYTES=256000
HARNESS_SANDBOX_CPU=1.0
HARNESS_SANDBOX_MEMORY_MB=512
HARNESS_SANDBOX_PIDS=128
HARNESS_SANDBOX_DISK_MB=1024

# Runtime persistence.
AGENTFORGE_STATE_DB=.agentforge/state.sqlite3
AGENTFORGE_TRACE_DIR=runs
